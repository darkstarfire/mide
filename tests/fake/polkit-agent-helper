#!/bin/sh
# polkit-agent-helper-1 FALSO dos testes do C7 (agente do polkit do mide). Nunca fala
# com o PAM nem com o polkit: lê o cookie da entrada, pergunta a senha como o helper
# de verdade ("PAM_PROMPT_ECHO_OFF ...") e confere com MIDE_TEST_POLKIT_PASSWORD.
# Usado pelo agente só em compilação de desenvolvimento (MIDE_POLKIT_HELPER).
#
# FAKE_HELPER_LOG: grava o usuário e o cookie recebidos (nunca a senha).
log="${FAKE_HELPER_LOG:-/dev/null}"
if [ $# -ne 1 ]; then
    echo "wrong number of arguments" >&2
    exit 1
fi
if [ -t 0 ]; then
    echo "stdin is a tty" >&2
    exit 1
fi
IFS= read -r cookie || exit 1
echo "usuário=$1 cookie=$cookie" >>"$log"
echo "PAM_PROMPT_ECHO_OFF Senha: "
IFS= read -r pass || { echo "FAILURE"; exit 1; }
if [ -n "${MIDE_TEST_POLKIT_PASSWORD:-}" ] && [ "$pass" = "$MIDE_TEST_POLKIT_PASSWORD" ]; then
    pass=""
    echo "resultado=aceita" >>"$log"
    echo "SUCCESS"
else
    pass=""
    sleep 0.3
    echo "resultado=recusada" >>"$log"
    echo "FAILURE"
fi
