#!/bin/sh
# Sessão do mide: é o que a tela de login (LightDM, GDM, greetd) executa ao escolher
# "mide". Define o ambiente de uma sessão Wayland e inicia o compositor direto na tela.

# Sem barramento de sessão (algumas telas de login não abrem um), roda o próprio script
# dentro de um: assim a espera pelo mide e a limpeza do fim (abaixo) valem também aí.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null; then
    exec dbus-run-session -- "$(readlink -f "$0")" "$@"
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=mide
export XDG_SESSION_DESKTOP=mide
export MIDE_SESSION=1
export MIDE_BACKEND=drm
# Apps que sabem usar Wayland passam a usá-lo (os só-X11 abrem pelo XWayland).
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export SDL_VIDEODRIVER="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
# Apps GTK 3 (e o Firefox fora do flatpak) usam o seletor de arquivos do portal, que na
# sessão do mide é o do mide (B25). Só nesta sessão: não vai para o systemd do usuário.
export GTK_USE_PORTAL=1
# Teclado na tela (mide-keyboard): os campos de texto falam com ele pelo Wayland
# (text-input v3). Com o IBus da distribuição no meio (GTK_IM_MODULE=ibus, comum no
# Debian/Ubuntu pelo im-config), os apps GTK nunca avisam o compositor e o teclado na
# tela não aparece. Quem usa outro método (fcitx, para chinês/japonês) continua com o
# dele. Qt: sem o QT_IM_MODULE=ibus, ele usa o text-input do Wayland sozinho.
case "${GTK_IM_MODULE:-}" in
    ""|ibus) export GTK_IM_MODULE=wayland ;;
esac
[ "${QT_IM_MODULE:-}" = ibus ] && unset QT_IM_MODULE

# Ícones e tema (claro/escuro) do mide nos apps GTK e Qt, só nesta sessão: um perfil
# próprio do dconf põe, por cima da configuração do usuário (que continua valendo e é
# onde tudo é gravado), um banco só de leitura que trava só essas chaves. Outras
# sessões (Cinnamon, GNOME) não usam esse perfil e não mudam. O compositor escreve o
# tema (`01-aparencia`) ao iniciar e quando as Configurações trocam.
if command -v dconf >/dev/null; then
    conf="${XDG_CONFIG_HOME:-$HOME/.config}/mide/dconf"
    mkdir -p "$conf/keyfiles/locks"
    rm -f "$conf/keyfiles/00-mide" "$conf/keyfiles/locks/00-mide"
    for icons in "${XDG_DATA_HOME:-$HOME/.local/share}/icons/mide" /usr/local/share/icons/mide /usr/share/icons/mide; do
        [ -f "$icons/index.theme" ] || continue
        printf "[org/gnome/desktop/interface]\nicon-theme='mide'\n" > "$conf/keyfiles/00-mide"
        echo /org/gnome/desktop/interface/icon-theme > "$conf/keyfiles/locks/00-mide"
        break
    done
    if dconf compile "$conf/mide.db" "$conf/keyfiles"; then
        printf 'user-db:user\nfile-db:%s\n' "$conf/mide.db" > "$conf/profile"
        export DCONF_PROFILE="$conf/profile"
    fi
fi
# Idioma e formatos escolhidos em Configurações → Idioma e região (`[locale]` no
# config.toml do mide); sem escolha, valem os do sistema (tela de login).
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/mide/config.toml"
if [ -f "$cfg" ]; then
    locale_value() { sed -n '/^\[locale\]/,/^\[/{s/^'"$1"' *= *"\([^"]*\)".*/\1/p}' "$cfg" | head -n 1; }
    lang="$(locale_value lang)"
    formats="$(locale_value formats)"
    if [ -n "$lang" ]; then
        export LANG="$lang" LANGUAGE="${lang%%.*}"
    fi
    if [ -n "$formats" ]; then
        export LC_TIME="$formats" LC_NUMERIC="$formats" LC_MONETARY="$formats" LC_PAPER="$formats" LC_MEASUREMENT="$formats"
    fi
fi
# Apps Qt seguem o GTK (tema de ícones, fontes) quando o plugin existe.
[ -z "$QT_QPA_PLATFORMTHEME" ] && export QT_QPA_PLATFORMTHEME=gtk3

# O compositor: ao lado deste script (instalado), ou o do projeto (desenvolvimento,
# com o script em data/), ou o do PATH.
dir="$(dirname "$(readlink -f "$0")")"
mide=mide
for candidate in "$dir/mide" "$dir/../target/release/mide" "$dir/../target/debug/mide"; do
    if [ -x "$candidate" ]; then
        mide="$candidate"
        break
    fi
done

# Log da sessão, para quando algo der errado (a tela não mostra o terminal).
log="${XDG_STATE_HOME:-$HOME/.local/state}/mide/session.log"
mkdir -p "$(dirname "$log")"
[ -f "$log" ] && mv -f "$log" "$log.anterior"

# Fim da sessão (também se o mide cair ou a tela de login encerrar a sessão): a pasta
# de portais do mide sai do ambiente do systemd do usuário e os portais que estão de pé
# com a configuração do mide param (voltam por ativação com o ambiente da próxima
# sessão), para o "Abrir…" de uma sessão do Cinnamon ou do GNOME aberta depois com o
# mesmo systemd não cair no seletor do mide. O mesmo que `session::stop` no mide.
fim_da_sessao() {
    if command -v systemctl >/dev/null; then
        systemctl --user unset-environment XDG_DESKTOP_PORTAL_DIR 2>/dev/null
        systemctl --user --no-block stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service 2>/dev/null
    fi
    command -v pkill >/dev/null && pkill -TERM -u "$(id -u)" -f "[m]ide-portal --portal-only"
}

# O mide em segundo plano e o script esperando: um SIGTERM/SIGHUP da tela de login
# (sair da sessão) passa ao mide, que fecha direito, e a limpeza roda depois.
"$mide" >"$log" 2>&1 &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM HUP INT
status=0
wait "$pid" || status=$?
# O `wait` volta também quando chega um sinal: espera o mide sair de verdade.
while kill -0 "$pid" 2>/dev/null; do
    status=0
    wait "$pid" || status=$?
done
fim_da_sessao
exit $status
