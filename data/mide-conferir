#!/bin/sh
# Confere a instalação do mide neste PC e mostra o que falta: binários de release,
# tema de ícones (mide-icons) na versão do projeto, o mide-session em uso, o tema de
# ícones da sessão e os erros recentes no log. Só lê; não muda nada.
#
# Uso: data/mide-conferir
cd "$(dirname "$(readlink -f "$0")")/.."

ok() { printf '  ok      %s\n' "$1"; }
falta() { printf '  FALTA   %s\n' "$1"; }
aviso() { printf '  aviso   %s\n' "$1"; }

echo "== código"
printf '  commit  %s\n' "$(git log --oneline -1 2>/dev/null)"
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then aviso "há mudanças locais sem commit"; fi
git fetch -q origin 2>/dev/null && [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/master 2>/dev/null)" ] && aviso "o GitHub tem commits novos: git pull"

echo "== binários (data/mide-atualizar compila)"
if [ -x target/release/mide ]; then
    if [ -n "$(find src Cargo.toml -newer target/release/mide -print -quit 2>/dev/null)" ]; then
        aviso "o código é mais novo que target/release/mide: rode data/mide-atualizar"
    else
        ok "target/release/mide em dia"
    fi
else
    falta "target/release/mide: rode data/mide-atualizar"
fi

echo "== tema de ícones (mide-icons)"
versao="$(cat data/icons.version)"
dados="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
instalada="$(cat "$dados/mide/.versao-mide-icons" 2>/dev/null)"
if [ "$instalada" = "$versao" ]; then
    ok "tema mide instalado em $dados/mide ($(echo "$versao" | cut -c1-8))"
elif [ -n "$instalada" ]; then
    aviso "tema mide na versão $(echo "$instalada" | cut -c1-8); o projeto pede $(echo "$versao" | cut -c1-8): rode data/mide-atualizar"
else
    falta "tema mide não instalado: rode data/mide-atualizar (precisa de git e internet)"
fi
for nome in mide-terminal mide-files mide-settings; do
    [ -e "$dados/hicolor/scalable/apps/$nome.svg" ] || aviso "$nome não está no hicolor (menus de outros ambientes sem o ícone)"
done

echo "== apps Qt com o tema do mide (ícones, claro/escuro)"
for versao in 5 6; do
    achou=""
    for plugin in /usr/lib/*/qt$versao/plugins/platformthemes/libqgtk3.so /usr/lib/qt$versao/plugins/platformthemes/libqgtk3.so; do
        [ -e "$plugin" ] && achou=1
    done
    if [ -n "$achou" ]; then
        ok "Qt $versao segue o GTK (qt$versao-gtk-platformtheme)"
    else
        aviso "Qt $versao sem o plugin do GTK: sudo apt install qt$versao-gtk-platformtheme (apps Qt $versao sem os ícones e o tema do mide)"
    fi
done

echo "== gravar a tela (OBS e vídeo do mide)"
if command -v xdg-desktop-portal-wlr >/dev/null || [ -x /usr/libexec/xdg-desktop-portal-wlr ]; then
    ok "xdg-desktop-portal-wlr instalado"
else
    falta "xdg-desktop-portal-wlr: sudo apt install xdg-desktop-portal-wlr"
fi
if command -v ffmpeg >/dev/null; then
    ok "ffmpeg instalado (gravar a tela em vídeo)"
else
    falta "ffmpeg: sudo apt install ffmpeg (obrigatório: gravar a tela em vídeo)"
fi
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal-wlr/mide" ]; then
    ok "portal wlr com a janela de escolha do mide"
else
    falta "configuração do portal wlr: rode data/mide-atualizar"
fi

echo "== apps do mide como padrão (B25)"
mimes="${XDG_CONFIG_HOME:-$HOME/.config}/mide-mimeapps.list"
if [ -f "$mimes" ]; then
    ok "escolhas do mide em $mimes (só valem na sessão do mide)"
else
    aviso "$mimes ainda não existe (a sessão do mide cria ao entrar)"
fi
for tipo in inode/directory text/plain; do
    app="$(env PATH="$PWD/target/release:$PATH" XDG_CURRENT_DESKTOP=mide XDG_DATA_DIRS="$PWD/data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" \
        gio mime "$tipo" 2>/dev/null | head -n 1 | sed 's/.*: //')"
    case "$app" in
        mide-*) ok "$tipo abre no $app na sessão do mide" ;;
        "") aviso "$tipo sem app padrão na sessão do mide" ;;
        *) aviso "$tipo abre no $app na sessão do mide (escolhido em Configurações → Apps padrão?)" ;;
    esac
done
if [ -f /usr/share/xdg-desktop-portal/portals/mide.portal ]; then
    ok "mide.portal instalado em /usr/share/xdg-desktop-portal/portals"
else
    aviso "mide.portal fora de /usr/share/xdg-desktop-portal/portals: a sessão monta uma pasta própria (XDG_DESKTOP_PORTAL_DIR)"
fi
[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services/org.freedesktop.impl.portal.desktop.mide.service" ] ||
    falta "ativação do seletor de arquivos do mide: rode data/mide-atualizar"
dono() {
    pid="$(gdbus call --session -d org.freedesktop.DBus -o /org/freedesktop/DBus -m org.freedesktop.DBus.GetConnectionUnixProcessID "$1" 2>/dev/null | sed -n 's/.*uint32 \([0-9]*\).*/\1/p')"
    [ -n "$pid" ] && cat "/proc/$pid/comm" 2>/dev/null
}
if [ "${XDG_CURRENT_DESKTOP:-}" = "mide" ]; then
    gerenciador="$(dono org.freedesktop.FileManager1)"
    case "$gerenciador" in
        mide-portal) ok "\"Mostrar na pasta\" abre o Arquivos do mide (FileManager1 é do mide-portal)" ;;
        "") falta "ninguém atende o FileManager1 (o mide-portal não iniciou? veja o log)" ;;
        *) aviso "FileManager1 é do $gerenciador: o \"Mostrar na pasta\" abre nele (o mide-portal assume quando ele sair)" ;;
    esac
    pasta="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_DESKTOP_PORTAL_DIR=//p')"
    if [ -f /usr/share/xdg-desktop-portal/portals/mide.portal ] || [ -e "$pasta/mide.portal" ]; then
        ok "o portal acha o seletor do mide"
    else
        falta "o portal não acha o mide.portal: saia e entre de novo na sessão (ou data/mide-atualizar --tudo)"
    fi
    [ -n "$(dono org.freedesktop.impl.portal.desktop.mide)" ] && ok "seletor de arquivos do mide no barramento" ||
        aviso "seletor de arquivos do mide fora do barramento (inicia no primeiro pedido)"
else
    printf '  (fora da sessão do mide: quem atende o "Mostrar na pasta" e o seletor só é conferido dentro dela)\n'
fi

echo "== senha de administrador (mide-sudo e polkit, C7)"
for prog in mide-sudo mide-askpass mide-polkit-agent; do
    [ -x "target/release/$prog" ] || falta "target/release/$prog: rode data/mide-atualizar"
done
if command -v sudo >/dev/null; then
    if id -nG | tr ' ' '\n' | grep -qxE 'sudo|wheel|admin'; then
        ok "sudo instalado e $(id -un) nos administradores (mide-sudo funciona)"
    else
        aviso "$(id -un) fora dos grupos sudo/wheel: o mide-sudo vai dizer que não tem permissão"
    fi
else
    falta "sudo não instalado (o mide-sudo depende dele)"
fi
helper=""
for h in /usr/lib/polkit-1/polkit-agent-helper-1 /usr/libexec/polkit-agent-helper-1 /usr/lib/policykit-1/polkit-agent-helper-1 /usr/libexec/polkit-1/polkit-agent-helper-1; do
    if [ -u "$h" ] && [ "$(stat -Lc %u "$h" 2>/dev/null)" = 0 ]; then helper="$h"; break; fi
done
if [ -n "$helper" ]; then
    ok "helper do polkit com setuid de root ($helper)"
else
    falta "polkit-agent-helper-1 com setuid não encontrado: sudo apt install polkitd (o pkexec não terá a janela do mide)"
fi
command -v xhost >/dev/null || aviso "xhost: sudo apt install x11-xserver-utils (apps abertos com o mide-sudo podem não achar a tela X11)"
if [ "${XDG_CURRENT_DESKTOP:-}" = "mide" ]; then
    if pgrep -u "$(id -u)" -x mide-polkit-agen >/dev/null; then
        ok "agente do polkit do mide rodando"
    else
        aviso "agente do polkit do mide não está rodando (veja \"agente do polkit\" no log da sessão)"
    fi
else
    printf '  (fora da sessão do mide: o agente do polkit só é conferido dentro dela)\n'
fi

echo "== cotações de moedas (Calculadora)"
if command -v curl >/dev/null; then
    ok "curl instalado (cotações do Banco Central)"
else
    aviso "curl: sudo apt install curl (sem ele, a Calculadora não busca as cotações das moedas)"
fi

echo "== sessão"
sessao="$(command -v mide-session)"
if [ -z "$sessao" ]; then
    falta "mide-session não está no PATH (a tela de login não acha a sessão)"
elif [ "$(readlink -f "$sessao")" = "$(readlink -f data/mide-session)" ]; then
    ok "mide-session é o deste projeto ($sessao)"
elif cmp -s "$sessao" data/mide-session; then
    ok "mide-session é uma cópia igual à do projeto ($sessao)"
else
    aviso "$sessao é uma cópia antiga: sudo cp data/mide-session $sessao"
fi
if [ "${XDG_CURRENT_DESKTOP:-}" = "mide" ]; then
    tema="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null)"
    if [ "$tema" = "'mide'" ]; then
        ok "apps GTK com o tema mide (DCONF_PROFILE=${DCONF_PROFILE:-})"
    else
        aviso "apps GTK com o tema $tema: saia e entre de novo na sessão do mide"
    fi
    # Apps na GPU (A25): sem o linux-dmabuf do compositor, caem no llvmpipe.
    if command -v eglinfo >/dev/null; then
        placa="$(eglinfo -B -p wayland 2>/dev/null | grep -m1 'OpenGL ES profile renderer' | sed 's/.*renderer: //')"
        case "$placa" in
            "") aviso "eglinfo não respondeu (apps na GPU não conferidos)" ;;
            *llvmpipe*|*softpipe*) falta "apps Wayland sem a GPU ($placa): veja \"linux-dmabuf\" no log da sessão" ;;
            *) ok "apps Wayland na GPU ($placa)" ;;
        esac
    else
        aviso "eglinfo: sudo apt install mesa-utils (para conferir se os apps usam a GPU)"
    fi
else
    printf '  (fora da sessão do mide: o tema dos apps GTK e a GPU dos apps só são conferidos dentro dela)\n'
fi

echo "== log da sessão"
log="${XDG_STATE_HOME:-$HOME/.local/state}/mide/sessao.log"
if [ -f "$log" ]; then
    erros="$(sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -cE ' (ERROR|WARN) ')"
    printf '  %s: %s aviso(s)/erro(s)\n' "$log" "$erros"
    sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -E ' (ERROR|WARN) ' | tail -8 | sed 's/^/    /'
else
    printf '  sem log ainda (%s)\n' "$log"
fi
