[Desktop Entry]
Type=Application
Name=Resource Monitor
Name[pt_BR]=Monitor de Recursos
Comment=See the apps and processes using the processor, memory, disk and network
Comment[pt_BR]=Veja os apps e processos que usam o processador, a memória, o disco e a rede
Exec=mide-monitor
Icon=utilities-system-monitor
Categories=System;Monitor;
Keywords=activity;process;cpu;memory;task;atividade;processo;memória;tarefa;
StartupWMClass=mide-monitor
OnlyShowIn=mide;
