# Apps padrão da sessão do mide (B25), com a prioridade mais baixa: só é lido com
# XDG_CURRENT_DESKTOP=mide, e esta pasta só entra no XDG_DATA_DIRS da sessão do mide.
# A escolha do usuário (Configurações → Apps padrão) fica em
# ~/.config/mide-mimeapps.list e vence esta.
[Default Applications]
inode/directory=mide-files.desktop
text/plain=mide-code.desktop
text/markdown=mide-code.desktop
text/x-log=mide-code.desktop
application/json=mide-code.desktop
application/x-shellscript=mide-code.desktop
text/rtf=mide-writer.desktop
application/rtf=mide-writer.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=mide-writer.desktop
application/vnd.oasis.opendocument.text=mide-writer.desktop
video/mp4=mide-player.desktop
video/x-matroska=mide-player.desktop
video/webm=mide-player.desktop
video/quicktime=mide-player.desktop
video/x-msvideo=mide-player.desktop
video/mpeg=mide-player.desktop
video/ogg=mide-player.desktop
