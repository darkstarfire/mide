[Desktop Entry]
Type=Application
Name=Editor de Capturas
Name[en]=Screenshot Editor
Comment=Recorte e marque capturas de tela e outras imagens
Exec=mide-screenshot-editor %f
Icon=mide-screenshot
Categories=Graphics;
MimeType=image/png;image/jpeg;
StartupWMClass=mide-screenshot-editor
OnlyShowIn=mide;
