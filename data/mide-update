#!/bin/sh
# Recompila o mide deste projeto e atualiza a sessão aberta, sem sair dela.
#
# Uso: data/mide-update          barra, dock, área de trabalho, notificações e
#                                   launcher com os programas novos (as janelas ficam)
#      data/mide-update --all   também o compositor: as janelas dos apps fecham,
#                                   mas a sessão continua (sem voltar ao login)
set -e
cd "$(dirname "$(readlink -f "$0")")/.."
PATH="$HOME/.cargo/bin:$PATH"
cargo build --release

# Tema de ícones do mide (fork do WhiteSur: github.com/fabioaacarneiro/mide-icons), na
# versão fixada em data/icons.version. Só instala de novo quando a versão muda.
instalar_icones() {
    versao="$(cat data/icons.version)"
    destino="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
    marca="$destino/mide/.versao-mide-icons"
    [ "$(cat "$marca" 2>/dev/null)" = "$versao" ] && return 0
    fonte="${XDG_CACHE_HOME:-$HOME/.cache}/mide/mide-icons"
    if [ ! -d "$fonte/.git" ]; then
        mkdir -p "$(dirname "$fonte")"
        git clone -q https://github.com/fabioaacarneiro/mide-icons.git "$fonte"
    fi
    git -C "$fonte" fetch -q origin
    git -C "$fonte" checkout -q "$versao"
    # Sem -a (redesenhos de apps do macOS) e sem -p: o tema já vem com a marca do mide.
    (cd "$fonte" && ./install.sh -n mide -d "$destino" >/dev/null 2>&1)
    # Os apps do mide também no hicolor: aparecem em qualquer tema (menus de outros
    # ambientes, sem o tema do mide).
    mkdir -p "$destino/hicolor/scalable/apps"
    for nome in mide-terminal mide-text mide-files mide-settings mide-screenshot mide-calculator mide-about; do
        cp -L "$destino/mide/apps/scalable/$nome.svg" "$destino/hicolor/scalable/apps/$nome.svg"
    done
    gtk-update-icon-cache -q -t "$destino/hicolor" 2>/dev/null || true
    echo "$versao" > "$marca"
    echo "ícones do mide instalados ($(echo "$versao" | cut -c1-8))"
}
instalar_icones || echo "aviso: os ícones do mide não foram instalados (sem rede?); tente de novo depois"

# Gravar a tela (OBS e outros): o portal wlr usa a janela do mide para escolher o
# monitor. O arquivo leva o nome do desktop ("mide"): só vale na sessão do mide.
portal_wlr="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal-wlr/mide"
mkdir -p "$(dirname "$portal_wlr")"
printf '[screencast]\nchooser_type=simple\nchooser_cmd=%s\n' "$PWD/target/release/mide-screencast-picker" > "$portal_wlr"
command -v xdg-desktop-portal-wlr >/dev/null || [ -x /usr/libexec/xdg-desktop-portal-wlr ] ||
    echo "aviso: para gravar a tela (OBS), instale o xdg-desktop-portal-wlr (sudo apt install xdg-desktop-portal-wlr)"
# Seletor de arquivos do mide nos apps (portal FileChooser, B25): ativação pelo D-Bus
# do backend, se o portal pedir antes de o compositor iniciar o mide-portal. Seguro em
# outras sessões: o xdg-desktop-portal só chama este nome com XDG_CURRENT_DESKTOP=mide
# (mide-portals.conf). O FileManager1 ("Mostrar na pasta") não tem arquivo de ativação
# de propósito: só o compositor do mide pede o nome, e só na sessão do mide.
servicos="${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services"
mkdir -p "$servicos"
printf '[D-BUS Service]\nName=org.freedesktop.impl.portal.desktop.mide\nExec=%s --portal-only\n' "$PWD/target/release/mide-portal" \
    > "$servicos/org.freedesktop.impl.portal.desktop.mide.service"
[ -f /usr/share/xdg-desktop-portal/portals/mide.portal ] ||
    echo "nota: o seletor de arquivos do mide vale ao entrar de novo na sessão (ou com $0 --all); para não depender da pasta de portais montada pela sessão: sudo install -m644 data/xdg-desktop-portal/portals/mide.portal /usr/share/xdg-desktop-portal/portals/"
command -v ffmpeg >/dev/null ||
    echo "aviso: para gravar a tela em vídeo pelo mide, instale o ffmpeg (sudo apt install ffmpeg)"
# --all (o antigo --tudo continua valendo)
if [ "${1:-}" = "--all" ] || [ "${1:-}" = "--tudo" ]; then
    echo "reiniciando o compositor (as janelas abertas vão fechar)..."
    target/release/mide-ctl restart all
else
    target/release/mide-ctl restart shell
    echo "barra, dock e afins atualizados. Para atualizar também o compositor: $0 --all"
fi
