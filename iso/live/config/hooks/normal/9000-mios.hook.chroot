#!/bin/sh
# Ajustes do mios dentro do chroot da ISO: login pelo greeter do mide (e, no modo live,
# direto na sessão do usuário mios), idiomas, nome da máquina e o alvo gráfico.
set -e

# Idiomas: inglês (padrão) e português do Brasil.
sed -i -E 's/^# *(en_US\.UTF-8 UTF-8)/\1/; s/^# *(pt_BR\.UTF-8 UTF-8)/\1/' /etc/locale.gen
locale-gen

# greetd com o greeter do mide; no modo live, a sessão do usuário mios abre direto
# (initial_session). O instalador do mios tira o initial_session do sistema instalado.
install -d -m755 /etc/greetd /etc/mide/login/mide
cp /etc/skel/.config/mide/config.toml /etc/mide/login/mide/config.toml
install -d -m755 -o _greetd /var/lib/mide-login
cat >/etc/greetd/config.toml <<'CONF'
[terminal]
vt = 7

[default_session]
command = "env XDG_CONFIG_HOME=/etc/mide/login XDG_STATE_HOME=/var/lib/mide-login XDG_DATA_DIRS=/usr/local/share:/usr/share MIDE_BACKEND=drm /usr/bin/mide --login"
user = "_greetd"

[initial_session]
command = "env XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=mide XDG_CURRENT_DESKTOP=mide /usr/bin/mide-session"
user = "mios"
CONF
systemctl enable greetd.service
# O greetd só depois do live-config (que cria o usuário mios no modo live); no sistema
# instalado, a unidade do live-config não existe e a ordem não muda nada.
install -d /etc/systemd/system/greetd.service.d
printf '[Unit]\nAfter=live-config.service systemd-user-sessions.service\n' >/etc/systemd/system/greetd.service.d/mios.conf
systemctl set-default graphical.target

echo mios >/etc/hostname

# Só no modo live (o instalador tira do sistema instalado): o instalador no launcher e
# abrindo sozinho, e o teste automático (parâmetro mios.autoinstall=DISCO do kernel).
cat >/usr/share/applications/mios-installer.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Install mios
Name[pt_BR]=Instalar o mios
Exec=mios-installer
Icon=system-software-install
Categories=System;
OnlyShowIn=mide;
DESK
install -d /etc/xdg/autostart
cat >/etc/xdg/autostart/mios-installer-live.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Install mios
Exec=mios-installer
NoDisplay=true
OnlyShowIn=mide;
DESK
install -d /usr/lib/mios
cat >/usr/lib/mios/autoinstall <<'SCRIPT'
#!/bin/sh
# Teste automático: instala no disco do parâmetro mios.autoinstall=DISCO e desliga.
disco="$(sed -n 's/.*mios\.autoinstall=\([^ ]*\).*/\1/p' /proc/cmdline)"
exec /usr/bin/mios-installer --auto "${disco:-/dev/vda}"
SCRIPT
chmod 755 /usr/lib/mios/autoinstall
cat >/etc/systemd/system/mios-autoinstall.service <<'UNIT'
[Unit]
Description=mios automatic installation (tests)
ConditionKernelCommandLine=mios.autoinstall
After=live-config.service systemd-udev-settle.service local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/mios/autoinstall
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable mios-autoinstall.service
