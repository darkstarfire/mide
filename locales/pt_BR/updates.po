# Tradução do mide para o português do Brasil: Atualização de Software (mide-updates) e
# os pacotes do sistema (mide::packages).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "A notification appears when updates are available"
msgstr "Uma notificação aparece quando há atualizações"

msgid "Cancelled."
msgstr "Cancelado."

msgid "Check Now"
msgstr "Verificar agora"

msgid "Check for updates automatically"
msgstr "Verificar atualizações automaticamente"

msgid "Checking for updates…"
msgstr "Procurando atualizações…"

msgid "Couldn’t update"
msgstr "Não foi possível atualizar"

msgid "Downloading…"
msgstr "Baixando…"

msgid "Everything is up to date."
msgstr "Tudo está atualizado."

msgid "Finishing…"
msgstr "Terminando…"

msgid "Installing updates…"
msgstr "Instalando as atualizações…"

msgid "Installing…"
msgstr "Instalando…"

msgid "Keep the computer on until it finishes."
msgstr "Mantenha o computador ligado até terminar."

msgid "Last checked: {when}"
msgstr "Última verificação: {when}"

msgid "Quit Software Update"
msgstr "Sair da Atualização de Software"

msgid "Removing…"
msgstr "Removendo…"

msgid "Restart Now"
msgstr "Reiniciar agora"

msgid "Restart the computer to finish."
msgstr "Reinicie o computador para terminar."

msgid "Security"
msgstr "Segurança"

msgid "Software Update"
msgstr "Atualização de Software"

msgid "The administrator password is needed to update."
msgstr "É preciso a senha de administrador para atualizar."

msgid "The update service (PackageKit) isn’t available."
msgstr "O serviço de atualização (PackageKit) não está disponível."

msgid "Update Now"
msgstr "Atualizar agora"

msgid "Updates installed"
msgstr "Atualizações instaladas"

msgid "Waiting for the password…"
msgstr "Esperando a senha…"

msgid "Waiting…"
msgstr "Esperando…"

msgid "Working…"
msgstr "Trabalhando…"

msgid "Your system is up to date"
msgstr "Seu sistema está atualizado"

msgid "{n} update available"
msgid_plural "{n} updates available"
msgstr[0] "{n} atualização disponível"
msgstr[1] "{n} atualizações disponíveis"

msgid "+{n} other"
msgid_plural "+{n} others"
msgstr[0] "+{n} outra"
msgstr[1] "+{n} outras"

msgid "Couldn’t check for a new mide version: {err}"
msgstr "Não foi possível ver se há uma versão nova do mide: {err}"

msgid "mide {version}"
msgstr "mide {version}"

msgid "You have version {version}."
msgstr "Você tem a versão {version}."

msgid "+{n} other change"
msgid_plural "+{n} other changes"
msgstr[0] "+{n} outra mudança"
msgstr[1] "+{n} outras mudanças"

msgid "The new version is built on this computer, in the background (it can take 15 to 40 minutes). The administrator password is asked in a window."
msgstr "A versão nova é compilada neste computador, em segundo plano (pode levar de 15 a 40 minutos). A senha de administrador é pedida numa janela."

msgid "Update mide"
msgstr "Atualizar o mide"

msgid "Updating mide to {version}…"
msgstr "Atualizando o mide para a {version}…"

msgid "Building ({done} of about {total} parts)…"
msgstr "Compilando ({done} de umas {total} partes)…"

msgid "Installing… (enter the administrator password in the window)"
msgstr "Instalando… (digite a senha de administrador na janela)"

msgid "You can keep using the computer; the build runs at low priority."
msgstr "Pode continuar usando o computador: a compilação roda com prioridade baixa."

msgid "mide {version} installed"
msgstr "mide {version} instalado"

msgid "It takes effect the next time you log in, or now by restarting the session (open app windows close)."
msgstr "Vale ao entrar de novo na sessão, ou agora, reiniciando a sessão (as janelas dos apps abertos fecham)."

msgid "Restart Session Now"
msgstr "Reiniciar a sessão agora"

msgid "Couldn’t update mide"
msgstr "Não foi possível atualizar o mide"

msgid "mide {version} is available"
msgstr "mide {version} está disponível"
